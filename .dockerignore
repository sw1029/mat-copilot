# Root-context dockerignore — azure.yaml builds backend/Dockerfile with context "."
# (backend/.dockerignore does not apply when the build context is the repo root)

# VCS / CI
.git/
.github/
.azure/
.azd/

# Docs & planning (not needed in image)
*.md
PRD/
TRD/
SCHEMA/
audit_result/
poc/
scripts/
infra/
azure.yaml

# Python
**/__pycache__/
**/*.py[cod]
backend/.venv/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/
backend/tests/
backend/docs/

# Node / frontend artifacts (rebuilt inside the image)
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/coverage/
frontend/.vite/

# Env / secrets
.env
.env.*
**/.env
**/.env.*

# Editor / OS
.vscode/
.idea/
.DS_Store
